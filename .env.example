# Copy values privately into the ignored .env; never commit actual credentials.
NODE_ENV=production
# REQUIRED fixed HTTPS origins, comma-separated. No wildcard or trailing path.
APP_ORIGINS=
# Enable only behind local Nginx that overwrites X-Real-IP.
TRUST_PROXY=false

# Real managed Supabase project. Production startup requires migration 004.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private DigitalOcean Spaces; no bucket creation or public ACLs.
SPACES_REGION=ams3
SPACES_BUCKET=marocora-translation-ledger-ams3
SPACES_KEY=
SPACES_SECRET=

# Required for actual upload scans. Missing/unavailable scanning fails closed.
CLOUDMERSIVE_API_KEY=

# LiveKit server-side credentials (not public/frontend variables).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicitly enable only for an owner-run synthetic live test.
LEARNING_VIDEO_ENABLED=false
LEARNING_VIDEO_MODE=live

# Opt-in local auth diagnostics: verified JWT claims + redacted connection errors.
LEARNING_VIDEO_DEBUG=false

# Live launcher only. Explicit HOST=0.0.0.0 enables IPv4 LAN access.
# LAN camera/microphone still require trusted HTTPS in the browser.
HOST=127.0.0.1
PORT=4195

# test:lan defaults to accountless Cloudflare Quick Tunnels (cloudflared on PATH).
# Optional ngrok retains its provider warning unless your plan/browser suppresses it.
LEARNING_TUNNEL_PROVIDER=cloudflare
